{
  "name": "llm-agent-evals",
  "version": "0.1.0",
  "description": "Tool-calling LLM agent with NDJSON streaming, model fallback, a rescue parser and an eval harness. Runs offline with a deterministic mock provider.",
  "author": "Sergio Atanacio",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "seed": "tsx scripts/seed.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "evals": "tsx evals/run.ts",
    "evals:compare": "tsx evals/run.ts --prompt v1 --compare v2"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
