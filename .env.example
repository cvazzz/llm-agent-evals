# Copy to .env (never commit .env). All values are optional; defaults run the mock provider.

# Provider: "mock" (deterministic, offline) or "openai" (any OpenAI-compatible /chat/completions endpoint)
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=mock-1
# Optional backup model, tried if the primary fails before any text was streamed
LLM_FALLBACK_MODEL=
LLM_TIMEOUT_MS=60000

PROMPT_VERSION=v2
MAX_TURNS=6
DAILY_LIMIT=200
CACHE_TTL_MS=600000

HOST=127.0.0.1
PORT=8787
# If set, POST /chat requires "Authorization: Bearer <API_TOKEN>"
API_TOKEN=
DATA_DIR=./data
# "Today" inside the synthetic dataset
AS_OF_DATE=2025-06-30
